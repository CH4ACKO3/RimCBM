<Project>
  <PropertyGroup>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and '$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$(HARMONY_DLL)</HarmonyAssemblyPath>
    <UseReferencePackages Condition="'$(UseReferencePackages)' == '' and '$(RimWorldManagedDir)' == ''">true</UseReferencePackages>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseReferencePackages)' == 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseReferencePackages)' != 'true'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences" Condition="'$(UseReferencePackages)' != 'true'">
    <Error Condition="!Exists('$(RimWorldManagedDir)/Assembly-CSharp.dll')" Text="Set RimWorldManagedDir or use -p:UseReferencePackages=true." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Set HarmonyAssemblyPath or HARMONY_DLL to 0Harmony.dll." />
  </Target>
</Project>

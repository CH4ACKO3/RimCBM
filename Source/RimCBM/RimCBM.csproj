<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RimCBM</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="../../Build/RimWorld.References.props" />
  <Target Name="PackageAssembly" AfterTargets="Build" Condition="'$(SkipModCopy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../../Assemblies" />
  </Target>
</Project>
